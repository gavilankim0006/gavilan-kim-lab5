# Copy this file to .env and fill in the values.
# Never commit .env — it contains secrets.

# Application
APP_NAME=Product Management API
APP_KEY=
APP_ENV=development
APP_URL=http://localhost:3000

# Database (Aiven MySQL)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# JWT / API
JWT_SECRET=
REFRESH_TOKEN_KEY=
JWT_ISSUER=crudlab6
JWT_AUDIENCE=crudlab6-clients

# CORS — set to your frontend origin in production
# Example: https://your-frontend.onrender.com
ALLOW_ORIGIN=*
